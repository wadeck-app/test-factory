{
  "name": "@wadeck-app/test-factory",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/app-module-school",
    "test": "npm run test --workspace=packages/app-module-school",
    "check": "npm run check --workspace=packages/app-module-school",
    "violations": "violations check",
    "check:scripts": "node scripts/check-scripts.mjs",
