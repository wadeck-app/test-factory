    "clean": "npm run clean --workspace=packages/app-module-school"
  },
  "devDependencies": {
    "@wadeck-app/app-core-cli": "latest",
    "@wadeck-app/app-core-sdk": "latest",
    "@wadeck-app/violations-cli": "latest",
    "@wadeck-app/violations-rules": "latest",
    "typescript": "^7.0.0",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=24"
  }
}
